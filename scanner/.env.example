# The API keys (OpenAI, Firecrawl, Google) are entered in the web UI and sent to the
# local server per request. The server does NOT read them from here, so you do not
# need a .env at all to run the app.
#
# This file only holds optional tuning. To use it: node --env-file=.env server.mjs

# The provider is auto-detected from the key you enter in the UI:
#   sk-...     -> OpenAI       (e.g. gpt-4o)
#   sk-or-...  -> OpenRouter   (e.g. stealth/ox-alpha, openai/gpt-4o)
#   nvapi-...  -> NVIDIA NIM    (e.g. meta/llama-3.2-90b-vision-instruct)
# The model must be VISION-capable to read the property's photos.
OPENAI_MODEL=gpt-4o
# OPENAI_TEMPERATURE=0.8        # set for a bit more layout variety
# OPENAI_MAX_TOKENS=16000
# OPENAI_BASE=...   # override the auto-detected endpoint (OpenAI / OpenRouter / NVIDIA / local)

# Firecrawl API base (change to /v2 if your account uses the v2 API).
# FIRECRAWL_BASE=https://api.firecrawl.dev/v1

# Overpass mirror (change if the default is rate-limited).
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Apify Google Maps actor (override for a different actor, e.g. one that also pulls emails).
# APIFY_ACTOR=compass~crawler-google-places

# Server
# PORT=5173
# HOST=127.0.0.1
