# Copy to .env.local for local dev. Everything is optional locally:
# without ANTHROPIC_API_KEY the "Write with AI" button returns the format's
# example (demo mode), without Upstash, data lives in memory.

# https://console.anthropic.com — used to write the slides
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Stripe (test keys first: sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Upstash Redis (required in production). Vercel's Upstash integration sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead; both names work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Free AI writes per IP per day, and a global daily cap across free users.
# FREE_PER_IP_PER_DAY=3
# FREE_GLOBAL_DAILY_CAP=500
