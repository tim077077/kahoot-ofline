# Copy to .env.local. Without ANTHROPIC_API_KEY the studio runs in demo mode
# (copying and writing return example output).

# https://console.anthropic.com — reads screenshots and writes the slides
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Optional: "Copy a creator" on Instagram (official Business Discovery API).
# Your own professional account's id and a Facebook user token. Setup steps:
# README → Copy a creator. Tokens last 60 days.
# IG_USER_ID=
# IG_ACCESS_TOKEN=
# IG_GRAPH_VERSION=v24.0

# Daily caps on AI calls (per IP, and in total). Lower these if you ever put
# the studio on the internet.
# AI_PER_IP_PER_DAY=100
# AI_GLOBAL_DAILY_CAP=300

# Only needed if you deploy it: Upstash Redis keeps the caps across restarts.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
