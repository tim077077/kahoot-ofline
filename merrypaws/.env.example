# Copy to .env.local for local dev. Everything is optional locally:
# without FAL_KEY previews run in demo mode (your photo, watermarked),
# without Upstash, data lives in memory, and without S3 album photos are
# written to .data/.

# https://fal.ai/dashboard/keys (~$0.039 per image with the default model)
FAL_KEY=
# FAL_MODEL=fal-ai/nano-banana/edit
# Runs only when the main model fails. Set it empty to turn the fallback off.
# FAL_FALLBACK_MODEL=fal-ai/gemini-3-pro-image-preview/edit
# Protects GET /api/stats (your funnel numbers).
# STATS_KEY=

# Album photo storage (required in production). Any S3-compatible bucket;
# Cloudflare R2 recommended. Give the bucket a CORS rule allowing GET from
# your site (and the app's origin) so share cards can draw the photos.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=paw-pictures
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Stripe (test keys first: sk_test_...). Webhook events: checkout.session.completed,
# checkout.session.async_payment_succeeded, invoice.paid, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Upstash Redis (required in production). Vercel's Upstash integration sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead; both names work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mobile app build only: where the app sends API calls (the deployed site).
# NEXT_PUBLIC_API_BASE=https://your-app.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=

# One free portrait preview per device; per-IP and global daily caps are the
# backstop. The global cap x $0.04 is your worst-case daily bill from free users.
# FREE_PER_DEVICE=1
# FREE_PER_IP_PER_DAY=3
# FREE_GLOBAL_DAILY_CAP=300
