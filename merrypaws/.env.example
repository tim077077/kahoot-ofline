# Copy to .env.local for local dev. Everything is optional locally:
# without GEMINI_API_KEY previews run in demo mode (your photo, watermarked),
# without Upstash, data lives in memory, and without S3 album photos are
# written to .data/.

# Google Gemini API key: https://aistudio.google.com/apikey (turn on billing;
# image models have no free tier). About $0.037 per portrait with the default.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Runs only when the main model fails. Set it empty to turn the fallback off.
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-image
# On Cloudflare, previews are watermarked by the Images binding (free plan
# friendly). Set to js to draw the watermark in the Worker instead; that needs
# Workers Paid ($5/mo) for the CPU time.
# WATERMARK_ENGINE=js
# Protects GET /api/stats (your funnel numbers).
# STATS_KEY=

# Album photo storage (required in production). Any S3-compatible bucket;
# Cloudflare R2 recommended. Give the bucket a CORS rule allowing GET from
# your site (and the app's origin) so share cards can draw the photos.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=paw-pictures
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# RevenueCat (payments on the web and in the store apps; setup in DEPLOY.md).
# Web Billing public API key (starts rcb_; use the sandbox key while testing).
NEXT_PUBLIC_REVENUECAT_WEB_KEY=
# Any long random string; paste the same value as the webhook's Authorization
# header in RevenueCat → Integrations → Webhooks (URL: /api/revenuecat).
REVENUECAT_WEBHOOK_AUTH=
# Set to "allow" while testing so sandbox purchases unlock things. Remove for launch.
# REVENUECAT_SANDBOX=allow
# The store apps (build variables for `npm run app:apk`, never the website):
# RevenueCat → Project settings → API keys, the Google Play and App Store keys.
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
# "Restore purchases" in the apps asks RevenueCat what's active: a secret
# (v1) API key from the same page. Server only.
REVENUECAT_SECRET_KEY=

# Upstash Redis (required in production). Some integrations set
# KV_REST_API_URL / KV_REST_API_TOKEN instead; both names work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Album backup emails (the 6-digit sign-in code). https://resend.com, free for
# 3,000 a month. Without a verified domain Resend only delivers to your own
# address, so verify a domain before friends try it. Locally, without a key,
# the code is printed in the terminal and shown on the page.
# RESEND_API_KEY=
# EMAIL_FROM=Paw Pictures <hello@yourdomain.com>

# Daily reminder (web push). Generate once: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Protects /api/push/cron. Any long random string; the hourly scheduler sends
# it as "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET=

# Push for friends' reactions in the Android/iOS apps (Firebase Cloud Messaging).
# Server: the whole service-account JSON on one line, from Firebase → Project
# settings → Service accounts → Generate new private key. Secret; never commit.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}
# App build: set to 1 only once google-services.json (android/app/) and
# GoogleService-Info.plist (ios/App/App/) are in place.
# NEXT_PUBLIC_NATIVE_PUSH=1

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mobile app build only: where the app sends API calls (the deployed site).
# NEXT_PUBLIC_API_BASE=https://paw-pictures.you.workers.dev
NEXT_PUBLIC_CONTACT_EMAIL=
# Store app only: Meta App ID for sharing straight into Instagram Stories
# (docs/INSTAGRAM.md).
# NEXT_PUBLIC_META_APP_ID=

# One free portrait preview per device; per-IP and global daily caps are the
# backstop. The global cap x $0.037 is your worst-case daily bill from free users.
# FREE_PER_DEVICE=1
# FREE_PER_IP_PER_DAY=3
# FREE_GLOBAL_DAILY_CAP=300
