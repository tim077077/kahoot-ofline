# Copy to .env.local for local dev. Everything is optional locally:
# without FAL_KEY previews run in demo mode (your photo, watermarked),
# without Upstash, data lives in memory.

# https://fal.ai/dashboard/keys (~$0.039 per image with the default model)
FAL_KEY=
# FAL_MODEL=fal-ai/nano-banana/edit

# Stripe (test keys first: sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Upstash Redis (required in production). Vercel's Upstash integration sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead; both names work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mobile app build only: where the app sends API calls (the deployed site).
# NEXT_PUBLIC_API_BASE=https://your-app.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=

# Free previews per IP per day, and a global daily cap on free previews.
# The cap x $0.04 is your worst-case daily AI bill from free users.
# FREE_PER_IP_PER_DAY=3
# FREE_GLOBAL_DAILY_CAP=300
