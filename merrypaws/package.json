{
  "name": "merrypaws",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "lab": "npx --yes tsx scripts/prompt-lab.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "app:build": "./scripts/build-app.sh && npx cap sync",
    "app:apk": "npm run app:build && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@google/genai": "^2.29.1",
    "@opennextjs/cloudflare": "^1.20.11",
    "@phosphor-icons/react": "^2.1.10",
    "@revenuecat/purchases-capacitor": "13.7.4",
    "@revenuecat/purchases-js": "1.67.1",
    "aws4fetch": "^1.0.20",
    "fast-png": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@tailwindcss/postcss": "^4",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "wrangler": "^4.151.0"
  }
}
