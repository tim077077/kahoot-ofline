# Copy this file to `.env` and fill in the keys you have. Both are optional —
# the intake script uses whichever is set and skips the other with a warning.
#
# Load it before running, e.g.:
#   set -a && . intake/.env && set +a && node intake/gather.mjs "Pensiunea Beauty, Cicir, Arad"

# Google Places API (New) — for a Google Maps pin: address, phone, hours, rating,
# up to 5 reviews, and a few photos.
# Get one at https://console.cloud.google.com/ → create a project → enable
# "Places API (New)" → enable billing (there is a monthly free credit) →
# Credentials → create an API key. Restrict it to the Places API.
GOOGLE_MAPS_API_KEY=

# Firecrawl — for scraping the property's OWN website / Booking / Facebook page
# (renders JavaScript, returns clean text + real photo URLs).
# Get one at https://www.firecrawl.dev/ → sign up → Dashboard → API key.
FIRECRAWL_API_KEY=
