# Copy to .env.local for local dev. Everything is optional locally:
# without FAL_KEY the studio runs in demo mode (returns your photo unchanged),
# without Upstash it keeps credits in memory.

# https://fal.ai/dashboard/keys — ~$0.039 per image with the default model
FAL_KEY=
# FAL_MODEL=fal-ai/nano-banana/edit

# Stripe (use test keys first: sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Upstash Redis (required in production). Vercel's Upstash integration sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead; both names work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Free generations per IP per day, and a global daily cap on free images.
# FREE_PER_IP_PER_DAY=1
# FREE_GLOBAL_DAILY_CAP=100
